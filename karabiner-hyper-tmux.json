{
    "title": "Caps Lock → Hyper → tmux direct bindings",
    "rules": [
        {
            "description": "Caps Lock → Hyper Key (⌃⌥⇧⌘) (Escape if alone)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "caps_lock" },
                    "to": [
                        {
                            "key_code": "left_shift",
                            "modifiers": ["left_command", "left_control", "left_option"]
                        }
                    ],
                    "to_if_alone": [{ "key_code": "escape" }]
                }
            ]
        },
        {
            "description": "Hyper+N → Shift+F1  (tmux: new-window)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "n",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f1", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+→ → Shift+F2  (tmux: next-window)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "right_arrow",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f2", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+← → Shift+F3  (tmux: previous-window)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "left_arrow",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f3", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+H → Shift+F4  (tmux: select-pane -L)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "h",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f4", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+J → Shift+F5  (tmux: select-pane -D)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "j",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f5", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+K → Shift+F6  (tmux: select-pane -U)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "k",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f6", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+L → Shift+F7  (tmux: select-pane -R)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "l",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f7", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+\\ → Shift+F8  (tmux: split-window -h)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "backslash",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f8", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+- → Shift+F9  (tmux: split-window -v)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "hyphen",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f9", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+D → Shift+F10  (tmux: detach-client)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "d",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f10", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+Z → Shift+F11  (tmux: zoom panel toggle)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "z",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f11", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+X → Shift+F12  (tmux: kill-pane z potwierdzeniem)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "x",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f12", "modifiers": ["left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+↑ → Ctrl+Shift+F1  (tmux: split panel above)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "up_arrow",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f1", "modifiers": ["left_control", "left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+/ → Ctrl+Shift+F2  (tmux: split panel left)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "slash",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f2", "modifiers": ["left_control", "left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+T → Ctrl+Shift+F3  (tmux: choose-tree window picker)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "t",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f3", "modifiers": ["left_control", "left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+S → Ctrl+Shift+F4  (tmux: choose-tree session picker)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "s",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f4", "modifiers": ["left_control", "left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+R → Alt+Shift+F1  (tmux: rename current window) — kanał 3, bo na kanale 2 (Ctrl+Shift+Fn) Hyper+R był zjadany przez macOS/jakąś apkę",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "r",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f1", "modifiers": ["left_alt", "left_shift"] }]
                }
            ]
        },
        {
            "description": "Hyper+Space → Ctrl+Shift+F6  (tmux: last-window toggle)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "spacebar",
                        "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
                    },
                    "to": [{ "key_code": "f6", "modifiers": ["left_control", "left_shift"] }]
                }
            ]
        }
    ]
}
